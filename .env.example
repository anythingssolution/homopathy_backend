PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=homopathy_clinic
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# OTP settings
DEFAULT_OTP=123456
OTP_EXPIRES_IN_SEC=300
OTP_RESEND_INTERVAL_SEC=60

# WhatsApp Cloud API settings
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_WELCOME_MESSAGE=dr. homopathy clinic me aapka swagat hai

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=600000
OTP_RATE_LIMIT_MAX=10
